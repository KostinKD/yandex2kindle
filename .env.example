# Обычно ключи вводятся на сайте: /settings. .env остаётся для ручной настройки.
# Получить токен отдельно: python3 -m app.yandex_auth
YANDEX_BOOK_TOKEN=
# 0 = manual sync only; positive values run on startup and periodically (min 60s).
YANDEX_SYNC_INTERVAL_SECONDS=0
# OpenSearch URL template; configure the catalog address available in your network.
FLIBUSTA_SEARCH_URL=https://flibusta.is/opds/search?searchTerm={searchTerms}&searchType=books&pageNumber={startPage?}
# Optional Z-Lib session cookies; required when the catalog requests authentication.
ZLIB_REMIX_USERID=
ZLIB_REMIX_USERKEY=
# Example: https://catalog.example/opds/search?q={searchTerms}&page={startPage?}
OPDS_SEARCH_URL=
# Extra trusted download/CDN origins, comma-separated (scheme + host + port).
REMOTE_ALLOWED_ORIGINS=https://static.flibusta.is,https://dln1.ncdn.ec
# Total remote download budget; read inactivity timeout is up to 120 seconds.
REMOTE_DOWNLOAD_TIMEOUT_SECONDS=600
# Connection establishment timeout, separate from waiting for response data.
REMOTE_CONNECT_TIMEOUT_SECONDS=60
# Respect proxy and CA settings present inside the container, like urllib does.
REMOTE_TRUST_ENV=true
# Optional override; empty uses browser-compatible catalog request headers.
REMOTE_USER_AGENT=
# Negotiate HTTP/2 where supported, and obtain the book page session before download.
REMOTE_HTTP2=true
REMOTE_BOOK_SESSION=true
# Only this user's reader progress is mirrored to/from the shared library panel.
KOSYNC_LIBRARY_USER=reader
# Register in KOReader first, then disable registration if desired.
KOSYNC_ALLOW_REGISTRATION=true
# Calendar dates and reading streaks for KOReader statistics.
READING_TIMEZONE=Europe/Moscow
# LAN IP of the computer (optional when starting with ./scripts/start.sh).
HOST_IP=
# Send-to-Kindle (доставка книг на почту @kindle.com через SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_TLS=true
KINDLE_EMAIL=
# Автосканирование папки incoming в секундах (0 отключает фоновый наблюдатель)
INCOMING_WATCH_INTERVAL_SECONDS=5
# Telegram Bot (загрузка книг, поиск и стрики через Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_AUTO_SEND_TO_KINDLE=false
